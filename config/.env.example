# Copie ce fichier en config/.env et remplis les valeurs.
# config/.env n'est jamais envoyé sur git (voir .gitignore).
# En production, ces mêmes variables se renseignent dans le tableau de bord de l'hébergeur.

# ===== Django =====
# Clé longue et aléatoire, différente en production. Pour en générer une :
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production : adresse complète du site, ex. https://orientia.cm
DJANGO_CSRF_TRUSTED_ORIGINS=
# Production derrière un hébergeur (Render, Railway, Nginx...) : True
DJANGO_DERRIERE_PROXY=False
# HSTS : 3600 (1 h) pour commencer, puis 31536000 (1 an) quand tout fonctionne en HTTPS
DJANGO_HSTS_SECONDS=3600

# ===== Base de données PostgreSQL (avec l'extension unaccent, livrée avec PostgreSQL) =====
# En ligne (Vercel + Neon) : une seule adresse, ajoutée automatiquement par l'intégration Neon :
# DATABASE_URL=postgresql://utilisateur:motdepasse@hote.neon.tech/base?sslmode=require
# En local : les réglages séparés ci-dessous (utilisés quand DATABASE_URL est vide)
DB_NAME=assistant_orientation
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Sauvegardes (manage.py sauvegarder_base) : chemin de pg_dump sous Windows, vide sous Linux
PG_DUMP_PATH=C:\Program Files\PostgreSQL\18\bin\pg_dump.exe

# ===== OrientIA : clé API Groq (https://console.groq.com/keys) =====
GROQ_API_KEY=
# Facultatif : changer de modèle sans toucher au code
# GROQ_CHAT_MODEL=openai/gpt-oss-120b
# GROQ_FAST_MODEL=openai/gpt-oss-20b
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# ===== Emails (mot de passe oublié, confirmation, rappels de concours) =====
# Exemple Brevo (300 emails/jour gratuits) : smtp-relay.brevo.com, port 587, identifiant et clé SMTP Brevo.
# Exemple Gmail : smtp.gmail.com, port 587, ton adresse et un « mot de passe d'application ».
# Laisser EMAIL_HOST vide en développement : les emails s'affichent dans le terminal.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=OrientIA <no-reply@orientia.cm>

# ===== Surveillance des erreurs (https://sentry.io, gratuit) =====
SENTRY_DSN=

# ===== Fond de carte =====
# OpenStreetMap convient en développement ; en production, prendre une clé gratuite chez MapTiler ou Stadia Maps, ex. :
# CARTE_TUILES_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=TA_CLE
# CARTE_TUILES_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap
CARTE_TUILES_URL=
CARTE_TUILES_ATTRIBUTION=

# ===== Connexion Google (https://console.cloud.google.com/apis/credentials) =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== Vercel =====
# Annales (fichiers PDF) : créer un « Blob store » dans le projet Vercel, BLOB_READ_WRITE_TOKEN est ajouté tout seul.
# BLOB_URL_BASE : adresse publique du store (facultatif), ex. https://abcd1234.public.blob.vercel-storage.com
BLOB_URL_BASE=
# Secret des tâches quotidiennes (Vercel Cron) : une longue chaîne aléatoire
CRON_SECRET=

# ===== KoboToolbox (manage.py importer_kobo) =====
KOBO_API_TOKEN=
KOBO_FORM_UID=
